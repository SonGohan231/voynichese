{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voynich-research-os.local/blind_annotation.schema.json",
  "title": "Voynich independent blind annotation submission",
  "type": "object",
  "required": ["schema_version", "annotation_id", "annotator_id", "blindness", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "annotation_id": {"type": "string", "minLength": 1},
    "annotator_id": {"type": "string", "minLength": 1},
    "blindness": {
      "type": "object",
      "required": ["other_annotation_unseen", "automated_candidates_unseen", "model_predictions_unseen", "hypothesis_labels_unseen", "split_assignment_unseen"],
      "additionalProperties": false,
      "properties": {
        "other_annotation_unseen": {"const": true},
        "automated_candidates_unseen": {"const": true},
        "model_predictions_unseen": {"const": true},
        "hypothesis_labels_unseen": {"const": true},
        "split_assignment_unseen": {"const": true}
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "source_sha256", "objects", "occlusions"],
        "properties": {
          "record_id": {"type": "string"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["local_id", "class", "bbox", "ports"],
              "properties": {
                "local_id": {"type": "string"},
                "class": {"enum": ["ILLUSTRATION_OBJECT", "ILLUSTRATION_FIELD", "TEXT_FIELD", "DIAGRAM"]},
                "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
                "ports": {"type": "array", "uniqueItems": true, "items": {"enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]}}
              },
              "additionalProperties": false
            }
          },
          "occlusions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "target_id", "relation"],
              "properties": {
                "source_id": {"type": "string"},
                "target_id": {"type": "string"},
                "relation": {"enum": ["IN_FRONT_OF", "BEHIND", "AMBIGUOUS"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
