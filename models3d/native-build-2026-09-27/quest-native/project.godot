config_version=5

[application]
config/name="Manuskrypt VR · Pracownia"
config/icon="res://icon.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
viewport/transparent_background=false

[xr]
openxr/enabled=true
openxr/extensions/hand_tracking=false
openxr/extensions/meta/passthrough=true
shaders/enabled=true
openxr/default_action_map="res://actions.tres"
openxr/foveation_level=2
openxr/foveation_dynamic=true

[audio]
driver/enable_input=true
