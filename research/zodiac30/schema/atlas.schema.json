{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voynich Zodiac 299 Atlas Row",
  "type": "object",
  "required": [
    "element_id",
    "folio",
    "panel_id",
    "x_native_r1",
    "y_native_r1",
    "x_native_r2",
    "y_native_r2",
    "measurement_delta_px",
    "ring_index",
    "audit_status",
    "source_sha256",
    "source_file"
  ],
  "properties": {
    "element_id": {"type": "string", "minLength": 1},
    "folio": {"type": "string"},
    "panel_id": {"type": "string"},
    "x_native_r1": {"type": "number"},
    "y_native_r1": {"type": "number"},
    "x_native_r2": {"type": "number"},
    "y_native_r2": {"type": "number"},
    "measurement_delta_px": {"type": "number", "minimum": 0},
    "ring_index": {"type": "integer", "minimum": 0},
    "audit_status": {"enum": ["PASS", "AMBIGUOUS", "REJECT"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_file": {"type": "string", "minLength": 1},
    "object_geometry_type": {"enum": ["POINT_CENTROID", "BBOX", "POLYGON", "MASK"]}
  }
}
